CLOUDSUNNY_ADDON_RAM_MONTHLY=25000
CLOUDSUNNY_ADDON_DISK_10GB_MONTHLY=15000
CLOUDSUNNY_CACHE_TTL=300

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
